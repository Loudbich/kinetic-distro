node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

# Artwork copied out of assets/ at build time — assets/ is the source of truth.
public/covers
public/artists
public/carousel
public/logo*

# Carousel masters and upscaler output — PNGs the site never serves. The slides
# themselves are exported as .webp, in both the root and mobile/, and those are
# a tenth of the size for no visible difference.
assets/Caroussel/*.png
assets/Caroussel/mobile/*.png
assets/**/*.psd
# A 552 MB Photoshop document landed in assets/covers named `Covers`, with no
# extension at all. The build skips it for lack of an image extension, but git
# would not have.
assets/covers/Covers
