{
  "name": "kinetic-distro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && tsc -b && npm run build:client && npm run build:ssr && npm run prerender",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync": "node scripts/sync-soundcloud.mjs",
    "assets": "node scripts/sync-assets.mjs",
    "attribution": "node scripts/build-attribution.mjs",
    "resolve": "node scripts/resolve-user-id.mjs",
    "test": "node scripts/test-parsers.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "audit": "node scripts/audit-seo.mjs",
    "preview:static": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
